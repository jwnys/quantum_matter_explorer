# Secrets: copy this file to `.env` (which is gitignored) and fill in what you use.
# Never commit `.env`. main.py loads it automatically via python-dotenv, so these
# land in os.environ for the run and are inherited by the vLLM subprocess.
#
#   cp .env.example .env    # then edit .env

# OpenAI cloud API (provider: openai). Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Anthropic cloud API (provider: anthropic). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# DeepSeek cloud API (provider: deepseek). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq cloud API (provider: groq). Get a key at https://console.groq.com
GROQ_API_KEY=

# Hugging Face token, only for the local vLLM path. Needed for gated models
# (e.g. Gemma requires accepting the license on huggingface.co first) and for
# higher download rate limits. Leave blank if your models are public or cached.
HF_TOKEN=
